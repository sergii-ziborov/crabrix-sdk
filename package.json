{
  "name": "crabrix",
  "version": "0.3.1",
  "description": "Encrypted, temporary Rust Playgrounds for agents and people. JavaScript SDK, live handoff and local Run/Debug over MCP.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mcp": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs"
    }
  },
  "bin": {
    "crabrix": "dist/cli.mjs",
    "crabrix-mcp": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ASSETS-LICENSE.md",
    "ThirdPartyNotices.txt"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "test": "node test.mjs",
    "prepack": "npm run check && npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.0.0",
    "typescript": "5.9.3",
    "tsx": "4.21.0",
    "esbuild": "0.25.12",
    "@modelcontextprotocol/server": "2.4.0",
    "yjs": "13.6.33",
    "y-protocols": "1.0.7",
    "zod": "4.3.6"
  },
  "homepage": "https://crabrix.com/playground/mcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergii-ziborov/crabrix-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/sergii-ziborov/crabrix-sdk/issues"
  },
  "keywords": [
    "crabrix",
    "mcp",
    "rust",
    "playground",
    "agents",
    "collaboration",
    "claude",
    "sdk",
    "typescript",
    "end-to-end-encryption"
  ]
}
